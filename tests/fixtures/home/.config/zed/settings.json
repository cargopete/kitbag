// Zed settings (JSONC: comments and trailing commas are allowed).
{
  "theme": "One Dark",
  "context_servers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKEzedfixturetoken0123456789abcdef" },
    },
    "docs": {
      "url": "https://mcp.docs.example.com/mcp",
      "headers": { "Authorization": "Bearer ${DOCS_TOKEN}" },
      "timeout": 90,
    },
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time"],
      "enabled": false,
    },
    // Provided by a Zed extension: no command, no url.
    "postgres-context-server": {
      "enabled": true,
      "settings": { "database_url": "postgresql://localhost/app" },
    },
    // The older layout, where command is an object.
    "old-style": {
      "command": { "path": "old-mcp", "args": ["--stdio"] },
    },
  },
}
