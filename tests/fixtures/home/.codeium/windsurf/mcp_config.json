{
  "mcpServers": {
    "figma": {
      "serverUrl": "https://mcp.figma.example.com/mcp",
      "headers": { "Authorization": "Bearer ${env:FIGMA_TOKEN}" }
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_PERSONAL_ACCESS_TOKEN}" }
    },
    "sentry": {
      "url": "https://mcp.sentry.example.com/mcp",
      "headers": { "X-Api-Key": "sntrys_FAKEeyJpYXQiOjE3MDAwMDAwMDAsInVybCI6Imh0dHBzOi8v" },
      "disabledTools": ["delete_issue"]
    },
    "time": {
      "command": "uvx",
      "args": ["mcp-server-time"],
      "disabled": true
    }
  }
}
