{
  // Copilot CLI user servers
  "mcpServers": {
    "playwright": {
      "type": "local",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "env": {},
      "tools": ["*"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7_FAKE0123456789abcdefghij"
      },
      "tools": ["resolve-library-id", "get-library-docs"]
    },
    "notes": {
      "type": "stdio",
      "command": "notes-mcp",
      "args": ["--root", "${NOTES_DIR:-/tmp/notes}"],
      "tools": ["*"]
    },
    "old-time": {
      "command": "uvx",
      "args": ["mcp-server-time"],
      "tools": ["*"]
    }
  }
}
