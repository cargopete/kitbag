{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKEfixtureTokenValue0123456789abcdef" },
      "autoApprove": ["search_repositories"],
      "timeout": 120
    },
    "docs": {
      "url": "https://mcp.docs.example.com/mcp",
      "type": "streamableHttp",
      "headers": { "Authorization": "Bearer ${DOCS_TOKEN}" }
    },
    "events": { "url": "https://events.example.com/sse", "type": "sse" },
    "legacy-remote": { "url": "https://legacy.example.com/sse" },
    "time": { "command": "uvx", "args": ["mcp-server-time"], "disabled": true },
    "odd": { "url": "https://odd.example.com/x", "type": "websocket" }
  }
}
