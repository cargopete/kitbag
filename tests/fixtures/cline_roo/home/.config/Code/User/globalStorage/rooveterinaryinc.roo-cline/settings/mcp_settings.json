{
  // Roo's own file, hand edited
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github", "--token=${env:GITHUB_TOKEN}"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "ghp_FAKEfixtureTokenValue0123456789abcdef" },
      "cwd": "/work/repo",
      "alwaysAllow": ["search_repositories"],
      "timeout": 90
    },
    "docs": {
      "type": "streamable-http",
      "url": "https://mcp.docs.example.com/mcp",
      "headers": { "Authorization": "Bearer ${env:DOCS_TOKEN}" }
    },
    "events": { "type": "sse", "url": "https://events.example.com/sse" },
    "typeless": { "url": "https://typeless.example.com/mcp" },
    "time": { "command": "uvx", "args": ["mcp-server-time"], "disabled": true },
  }
}
