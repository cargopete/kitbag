{
  // opencode 1 layout: servers directly under "mcp", turned off with "enabled"
  "mcp": {
    "docs": { "type": "remote", "url": "https://docs.example.com/mcp" },
    "tracker": {
      "type": "local",
      "command": ["tracker-mcp", "--stdio"],
      "environment": { "TRACKER_TOKEN": "{env:TRACKER_TOKEN}" },
      "enabled": false
    }
  }
}
